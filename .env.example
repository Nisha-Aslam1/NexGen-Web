# NexGen Council Production Environment Configuration

NODE_ENV=production
PORT=3000
SESSION_SECRET=nexgen_council_secure_session_secret_2026

# Database Settings
MONGODB_URI=mongodb://127.0.0.1:27017/nexgen_council
MONGODB_DB_NAME=nexgen_council

# Optional Domain Settings
SITE_URL=https://nexgencouncil.bond
MEETING_URL=https://meet.nexgencouncil.bond

# Jitsi as a Service (JaaS) / 8x8.vc Configuration
JAAS_APP_ID=vpaas-magic-cookie-xxx
JAAS_API_KEY_ID=vpaas-magic-cookie-xxx/apiKeyId
JAAS_PRIVATE_KEY_PATH=/etc/jaas/jaas_private_key.pem

